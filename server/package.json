{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src --env-file=.env src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "migrate": "node-pg-migrate -m migrations --migration-file-language sql",
    "migrate:down": "node-pg-migrate -m migrations --migration-file-language sql down",
    "migrate:up": "node-pg-migrate -m migrations --migration-file-language sql up",
    "migrate:create": "node-pg-migrate -m migrations --migration-file-language sql create",
    "seed": "node --env-file=.env src/db/seed.js",
    "race": "node --env-file=.env scripts/race-test.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
